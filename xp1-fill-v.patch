+#if XRSR128_XP_USE_NEON
+/* Experimental NEON fast path for the single stream (testing only).  Batch two
+ * consecutive steps into the two 64-bit lanes -- lane0 = step t, lane1 = step
+ * t+1 (t+1 is step1 of t) -- and vectorize only the OUTPUT stage (sr, both
+ * rotations, adds, interleave).  The state transition stays scalar: it is
+ * serial, so it cannot be widened, and this is the whole point -- the SIMD
+ * output runs on the vector unit while the serial step1 latency is exposed.
+ * Bit-identical to xrsr128_xp1_fill() (same formulas; verified byte-for-byte).
+ *
+ * Effect on Apple M2 (clang 17, -O3 -march=native), xrsr128_xp1_fill vs this:
+ *   ~0.863 -> ~0.573 ns/word  (~1.5x, +34%), flat from 1 KB to 32 KB fills.
+ * The scalar fill serializes output work with step1; here it overlaps, so this
+ * lands at the serial-step1 floor.  Non-NEON builds keep the scalar path. */
+static inline void xrsr128_xp1_fill_v(xrsr128_xp1_t * const s,
+                                      uint64_t * const dst, size_t n) {
+    size_t i = 0;
+    if (s->phase) { dst[i++] = s->pending; s->phase = 0; }
+    uint64_t s0 = s->s0, s1 = s->s1;                 /* base kept in registers */
+    for (; i + 3 < n; i += 4) {
+        const uint64_t n1a = s0 ^ s1;
+        const uint64_t ns0 = xrsr128_xp_rotl64(s0, 24) ^ n1a ^ (n1a << 16);
+        const uint64_t ns1 = xrsr128_xp_rotl64(n1a, 37);
+        const uint64_t n1b = ns0 ^ ns1;
+        const uint64_t ms0 = xrsr128_xp_rotl64(ns0, 24) ^ n1b ^ (n1b << 16);
+        const uint64_t ms1 = xrsr128_xp_rotl64(n1b, 37);
+        const xrsr128_xp_chunk_t S0v = vcombine_u64(vcreate_u64(s0),  vcreate_u64(ns0));
+        const xrsr128_xp_chunk_t S1v = vcombine_u64(vcreate_u64(s1),  vcreate_u64(ns1));
+        const xrsr128_xp_chunk_t N1v = XRSR128_XP_XOR(S0v, S1v);   /* = [n1a, n1b] */
+        const xrsr128_xp_chunk_t t16 = XRSR128_XP_SLLI(N1v, 16);
+        const xrsr128_xp_chunk_t srv = xrsr128_xp_sr(N1v, t16);
+        const xrsr128_xp_chunk_t o0 = XRSR128_XP_ADD(S0v, XRSR128_XP_ROT0V(srv));
+        const xrsr128_xp_chunk_t o1 = XRSR128_XP_ADD(S1v, XRSR128_XP_ROT1V(srv));
+        XRSR128_XP_STORE(&dst[i],   vzip1q_u64(o0, o1));
+        XRSR128_XP_STORE(&dst[i+2], vzip2q_u64(o0, o1));
+        s0 = ms0; s1 = ms1;
+    }
+    s->s0 = s0; s->s1 = s1;                          /* single write-back */
+    xrsr128_xp1_fill(s, &dst[i], n - i);             /* scalar tail */
+}
+#endif
